module uart_rx #(
    parameter CLKS_PER_BIT = 434, // 115200 Baud Rate
    parameter PARITY_TYPE  = 0    // 0 = Even Parity, 1 = Odd Parity
)(
    input  wire       i_Clock,
    input  wire       i_Rx_Serial,
    output reg        o_Rx_DV,     
    output reg [7:0]  o_Rx_Byte,
    output reg        o_Rx_Parity_Error // NEW: Flags high if parity fails
);

    // State Machine States
    localparam s_IDLE          = 3'b000;
    localparam s_RX_START_BIT  = 3'b001;
    localparam s_RX_DATA_BITS  = 3'b010;
    localparam s_RX_PARITY_BIT = 3'b011; // NEW STATE
    localparam s_RX_STOP_BIT   = 3'b100;
    localparam s_CLEANUP       = 3'b101;
    
    reg [2:0] r_SM_Main     = 0;
    reg [15:0] r_Clock_Count = 0;
    reg [2:0] r_Bit_Index   = 0;
    reg        r_Expected_Parity = 0;

    always @(posedge i_Clock) begin
        case (r_SM_Main)
            s_IDLE: begin
                o_Rx_DV           <= 1'b0;
                o_Rx_Parity_Error <= 1'b0;
                r_Clock_Count     <= 0;
                r_Bit_Index       <= 0;
                
                if (i_Rx_Serial == 1'b0) begin
                    r_SM_Main <= s_RX_START_BIT;
                end
            end
            
            s_RX_START_BIT: begin
                if (r_Clock_Count == (CLKS_PER_BIT-1)/2) begin
                    if (i_Rx_Serial == 1'b0) begin
                        r_Clock_Count <= 0;
                        r_SM_Main     <= s_RX_DATA_BITS;
                    end else begin
                        r_SM_Main <= s_IDLE;
                    end
                end else begin
                    r_Clock_Count <= r_Clock_Count + 1;
                end
            end
            
            s_RX_DATA_BITS: begin
                if (r_Clock_Count < CLKS_PER_BIT-1) begin
                    r_Clock_Count <= r_Clock_Count + 1;
                end else begin
                    r_Clock_Count          <= 0;
                    o_Rx_Byte[r_Bit_Index] <= i_Rx_Serial;
                    
                    if (r_Bit_Index < 7) begin
                        r_Bit_Index <= r_Bit_Index + 1;
                    end else begin
                        r_Bit_Index <= 0;
                        r_SM_Main   <= s_RX_PARITY_BIT; // Move to Parity Check
                    end
                end
            end
            
            s_RX_PARITY_BIT: begin
                // Wait one full bit period to sample the middle of the parity bit
                if (r_Clock_Count < CLKS_PER_BIT-1) begin
                    r_Clock_Count <= r_Clock_Count + 1;
                end else begin
                    r_Clock_Count <= 0;
                    
                    // Calculate what the parity SHOULD be based on received data
                    if (PARITY_TYPE == 0) begin
                        r_Expected_Parity = ^o_Rx_Byte;     // Even
                    end else begin
                        r_Expected_Parity = ~(^o_Rx_Byte);  // Odd
                    end
                    
                    // Compare expected parity to the actual bit on the wire
                    if (i_Rx_Serial != r_Expected_Parity) begin
                        o_Rx_Parity_Error <= 1'b1; // Data corrupted!
                    end else begin
                        o_Rx_Parity_Error <= 1'b0; // Data is safe
                    end
                    
                    r_SM_Main <= s_RX_STOP_BIT;
                end
            end
            
            s_RX_STOP_BIT: begin
                if (r_Clock_Count < CLKS_PER_BIT-1) begin
                    r_Clock_Count <= r_Clock_Count + 1;
                end else begin
                    // Only assert Data Valid if there was NO parity error
                    if (o_Rx_Parity_Error == 1'b0) begin
                        o_Rx_DV <= 1'b1; 
                    end
                    r_Clock_Count <= 0;
                    r_SM_Main     <= s_CLEANUP;
                end
            end
            
            s_CLEANUP: begin
                o_Rx_DV   <= 1'b0;
                r_SM_Main <= s_IDLE;
            end
            
            default: r_SM_Main <= s_IDLE;
        endcase
    end
endmodule